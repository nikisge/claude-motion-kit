  "files": {
   "chime.mp3": {
    "description": "Weicher melodischer Klang: Erfolg/Bestätigung oder leichter Übergang"
   },
   "click-soft.mp3": {
    "description": "Leiser kurzer Klick: dezenter UI-Tap, weiche Auswahl"
   },
   "click.mp3": {
    "description": "Knackiger UI-Klick: Button, Toggle, Auswahl"
   },
   "error.mp3": {
    "description": "Negativer Fehlerton: falsch, Abbruch, glitchige Unterbrechung"
   },
   "glitch-1.mp3": {
    "description": "Kräftiger Digital-Glitch: harter Schnitt-Akzent, plötzlicher Reveal; Ausklang läuft in nächste Einstellung"
   },
   "glitch-2.mp3": {
    "description": "Harter langer Glitch: chaotischer Übergang, verzerrter Reveal"
   },
   "glitch-3.mp3": {
    "description": "Leise Glitch-Textur: subtile digitale Verschiebung unter anderem Ton"
   },
   "impact-bass-1.mp3": {
    "description": "Bass-Einschlag: Logo/Held landet, Headline-Slam"
   },
   "impact-bass-2.mp3": {
    "description": "Bass-Einschlag mit kurzem Anschwellen: Spitze auf den Reveal legen"
   },
   "key-press.mp3": {
    "description": "Einzelner Tastenanschlag: ein Zeichen, Terminal-Eingabe"
   },
   "notification.mp3": {
    "description": "Benachrichtigungs-Klang: Toast/Badge/Nachricht erscheint"
   },
   "ping.mp3": {
    "description": "Scharfer elektronischer Ping: Akzent auf Zahl oder Datenpunkt"
   },
   "pop.mp3": {
    "description": "Schneller Pop: Element erscheint, Chip/Tag springt rein"
   },
   "riser.mp3": {
    "description": "Langer Kino-Riser (~10 s, Spitze am Ende): bei Reveal-Zeit minus 10,03 s starten (align end)"
   },
   "sparkle.mp3": {
    "description": "Heller Glitzer/Schimmer: magischer Reveal, Glanz auf Held-Element"
   },
   "typing.mp3": {
    "description": "Tipp-Salve (~1,5 s): Text/Code tippt sich"
   },
   "whoosh-cinematic.mp3": {
    "description": "Kino-Whoosh mit Aufbau (~5,5 s): großer Szenenwechsel, Anschwellen endet auf dem Schnitt"
   },
   "whoosh-short.mp3": {
    "description": "Kurzer Whoosh: schneller Wisch, Element gleitet"
   },
   "whoosh.mp3": {
    "description": "Kräftiger Whoosh mit Schlag: schneller Reveal, harter Übergang"
   }
  }
